<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
    <classPathEntry location="mysql-connector-java-5.1.25-bin.jar"/>
    <context id="context1" targetRuntime="MyBatis3">

        <property name="autoDelimitKeywords" value="true"/>
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>

        <commentGenerator>
            <property name="suppressDate" value="true"/>
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>


        <!-- 数据库连接配置 -->
        <jdbcConnection driverClass="com.mysql.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3307/doc_demo?useSSL=false&amp;characterEncoding=UTF-8"
                        userId="root" password="123456"/>


        <!-- Java类型解析器 -->
        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>


        <!-- 实体类生成配置 -->
        <javaModelGenerator targetPackage="com.taoge.biz.persistent.entity" targetProject="src/"/>


        <!-- Mapper XML文件生成配置 -->
        <sqlMapGenerator targetPackage="com.taoge.biz.persistent.mapper" targetProject="src/">
            <property name="" value=""/>
        </sqlMapGenerator>

        <!-- Mapper接口生成配置 -->
        <javaClientGenerator targetPackage="com.taoge.biz.persistent.dao"
                             targetProject="src/"
                             type="MIXEDMAPPER"/>


        <javaServiceGenerator targetPackage="com.taoge.biz.persistent.service" targetProject="src/" type=""/>


        <table tableName="article" delimitIdentifiers="true"
               enableDeleteByPrimaryKey="true"
               enableCountByExample="false"
               enableUpdateByExample="false"
               enableDeleteByExample="false"
               enableSelectByExample="false"
               selectByExampleQueryId="false">
            <!--                        <property name="useActualColumnNames" value="true"/>-->
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="article_category" delimitIdentifiers="true"
               enableDeleteByPrimaryKey="true"
               enableCountByExample="false"
               enableUpdateByExample="false"
               enableDeleteByExample="false"
               enableSelectByExample="false"
               selectByExampleQueryId="false">
            <!--                        <property name="useActualColumnNames" value="true"/>-->
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>

        <table tableName="article_statistics" delimitIdentifiers="true"
               enableDeleteByPrimaryKey="true"
               enableCountByExample="false"
               enableUpdateByExample="false"
               enableDeleteByExample="false"
               enableSelectByExample="false"
               selectByExampleQueryId="false">
            <!--                        <property name="useActualColumnNames" value="true"/>-->
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>








    </context>
</generatorConfiguration>