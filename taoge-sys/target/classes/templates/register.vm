<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>注册</title>
    <link href="/static/css/bootstrap.min.css" rel="stylesheet">
    <link href="/static/css/common.css" rel="stylesheet">
    <!--if lt IE 9
    script(src='http://apps.bdimg.com/libs/html5shiv/r29/html5.min.js')
    script(src='http://apps.bdimg.com/libs/respond.js/1.4.2/respond.min.js')
    -->
    <style>
        html,body{
        min-height:100%;
        }
        body{
        background:url(/static/css/loginbgNew.jpg) 0 center no-repeat;background-size:100% 100%;
        }
        .container{
        margin:150px auto;
        }
        .page-login{
        width:400px;background:rgba(255,255,255,0.3);padding:40px;
        }
        .page-login input{
        border-radius: 0;border:none;line-height:34px;height:34px;
        }
        .page-login .help-block{
        color:#fff;
        }
        .page-login .btn{
        width:100%;background:#333;border:none;border-radius:0;
        }
        .page-login .alert-danger{
        padding:10px 15px;border-radius:0;
        }
    </style>
    <script src="/static/js/jquery.min.js"></script>
    <script src="/static/js/bootstrap.min.js"></script>
    <script src="/static/js/common.js"></script>
    <script src="/static/js/cookie.js"></script>
</head>
<body>
<div class="container">
    <div class="page-login">
        <form>
            <div class="form-group">
                <p class="help-block">用户注册：</p>
                <input id="username" type="text" placeholder="用户名" class="form-control">
            </div>
            <div class="form-group">
                <input id="password" maxlength="20" type="password" placeholder="密码" class="form-control">
            </div>
            <div class="form-group">
                <input id="confirmPassword" maxlength="20" type="password" placeholder="确认密码" class="form-control">
            </div>
            <div class="form-group">
                <input id="merchantName" maxlength="20" type="text" placeholder="商户名称" class="form-control">
            </div>
            <div class="form-group">
                <input id="merchantLogo" maxlength="20" type="text" placeholder="商户logo" class="form-control">
            </div>
            <div class="form-group">
                <input id="mobile" maxlength="20" type="text" placeholder="手机号" class="form-control">
            </div>
            <div class="form-group">
                <button id="btnBindUser" type="button" class="btn btn-lg btn-primary">注册</button>
            </div>
        </form>
        <div role="alert" class="alert alert-danger hidden">.密码错误.</div>
    </div>
</div>
<script>
      var cookieOption = {day : 365};
      $(function(){
          $("#password").keypress(function(e){
            if (e.keyCode == 13) {
              register()
            }
          });
          $("#btnBindUser").click(register);
      });
      function register() {
          if ($.trim($("#username").val()) == "" || $.trim($("#password").val()) == "" || $.trim($("#confirmPassword").val()) == "") {
              $.alert("请填写账号及密码");
              return;
          }
          if ($.trim($("#merchantName").val()) == "" || $.trim($("#merchantLogo").val()) == "" || $.trim($("#mobile").val()) == "") {
              $.alert("请填写商户信息");
              return;
          }
          var data = {
              username : $("#username").val(),
              password : $("#password").val(),
              confirmPassword : $("#confirmPassword").val(),
              merchantName : $("#merchantName").val(),
              merchantLogo : $("#merchantLogo").val(),
              mobile : $("#mobile").val()
          };
          ajax("/api/security/register", data, function(data){
            if (data && data.code) {
                if (data.code == 200) {
                    $.alert(data.msg, {}, function() {
                        window.location.href = "/login";
                    });
                }else {
                    $.alert(data.msg);
                }
            }else {
                $.alert("注册失败");
            }
          });
      }
    </script>
<#include "/common/dialog.vm" />
</body>
</html>