<script type="text/javascript">
	var categoryMap = {};
	function setSelectCategory(param, level, id) {
	    if(level == 2) {
	        param["threeCategoryId"] = id;
	    } else if (level == 1) {
	        param["twoCategoryId"] = id;
	    } else if (level == 0) {
	        param["oneCategoryId"] = id;
	    }
	    if(level && level >= 0) {
	        return setSelectCategory(param, level - 1, categoryMap[id].parentId);
	    }
	    return param;
	}
	function set_categoryMap(){
		ajax("/api/productCategory/allCategory",'',function (data) {
		    if (data.code == 200) {
		        if (data.data) {
		            if(data.data && data.data.length > 0) {
		                for(var i = 0; i < data.data.length; i++) {
		                    categoryMap[data.data[i].id] = data.data[i];
		                }
		            }
		        }
		    }
		}, {async: false});
	}
	function getSearchParamFor_categoryLv3(param){
		var categorySelect = $("#selectAll option:selected");
		if(categorySelect) {
		    param = setSelectCategory(param, categorySelect.data("level"), categorySelect.val());
		}
		return param;
	}
</script>