<script type="text/javascript">
    function renderTmpl(id,data){
      return $.tmpl($("#"+id).html(),data);
    }
    $(function(){
        if($.fn.rendeTable) return;
        $.fn.rendeTable = function(data,options){
            var dom = $.tmpl($("#tmpl-common-table").html(),{list:data,options:options});
            $(this).html(dom);
        }
    })
</script>