<!-- 
视频播放浮层,aliplayer
 -->
<link rel="stylesheet" href="https://g.alicdn.com/de/prismplayer/2.8.8/skins/default/aliplayer-min.css" />
<script type="text/javascript" charset="utf-8" src="https://g.alicdn.com/de/prismplayer/2.8.8/aliplayer-min.js"></script>
<style type="text/css">
	.bg-vplayer{
		background-color: rgba(0,0,0,0.5);
		position: fixed;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		z-index: 999;
	}
	.bg-vplayer .player-content{
		width: 800px;
		height: 600px;
		top:50%;
		left: 50%;
		transform: translate(-50%,-50%);
		position: fixed;
		background-color: black;
	}
	.glyphicon.glyphicon-remove-circle.btn-close-in-vplayer {
	    position: fixed;
	    font-size: 50px;
	    color: white;
	    right: 50px;
	    top: 50px;
	    cursor: pointer;
	}
</style>
<div class="bg-vplayer hide">
	<div class="glyphicon glyphicon-remove-circle btn-close-in-vplayer"></div>
	<div class="player-content">
		<div id="vplayer-mp4"></div>
	</div>
</div>
<script type="text/javascript">
	$('.btn-close-in-vplayer').click(function(){
		$('.bg-vplayer').addClass('hide');
		if(__vplayer){
			__vplayer.pause();
		}
		$('.bg-vplayer .player-content').html('<div id="vplayer-mp4"></div>');
	})
	var __vplayer = null;
function callVideoPlayer(url){
	var video_id = 'vplayer-mp4';
	$('.bg-vplayer').removeClass('hide');
	__vplayer = new Aliplayer({
	  "id": video_id,
	  "source": url,
	  "width": "800px",
	  "height": "600px",
	  "autoplay": true,
	  "isLive": false,
	  "rePlay": false,
	  "playsinline": true,
	  "preload": true,
	  "controlBarVisibility": "hover",
	  "useH5Prism": true
	}, function (player) {
	  }
	);
}
</script>