<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>登录</title>
    <link href="/static/css/bootstrap.min.css" rel="stylesheet">
    <link href="/static/css/common.css" rel="stylesheet">
    <!--if lt IE 9
    script(src='http://apps.bdimg.com/libs/html5shiv/r29/html5.min.js')
    script(src='http://apps.bdimg.com/libs/respond.js/1.4.2/respond.min.js')
    -->
    <style>
        html,body{
        min-height:100%;
        }
        body{
        background:url(/static/css/loginbgNew.jpg) 0 center no-repeat;background-size:100% 100%;
        }
        .container{
        margin:150px auto;
        }
        .page-login{
        width:400px;background:rgba(255,255,255,0.3);padding:40px;
        }
        .page-login input{
        border-radius: 0;border:none;line-height:34px;height:34px;
        }
        .page-login .help-block{
        color:#fff;
        }
        .page-login .btn{
        width:100%;background:#333;border:none;border-radius:0;
        }
        .page-login .alert-danger{
        padding:10px 15px;border-radius:0;
        }
    </style>
    <script src="/static/js/jquery.min.js"></script>
    <script src="/static/js/bootstrap.min.js"></script>
    <script src="/static/js/common.js"></script>
    <script src="/static/js/cookie.js"></script>
</head>
<body>
<div class="container">
    <div class="page-login">
        <form>
            <div class="form-group">
                <p class="help-block">用户登录：</p>
                <input id="username" type="text" placeholder="用户名" class="form-control">
            </div>
            <div class="form-group">
                <input id="password" maxlength="20" type="password" placeholder="密码" class="form-control">
            </div>
            <div class="form-group">
                <label class="checkbox-inline help-block">
                    <input id="rp" type="checkbox" value="1" style="height: auto;"> 是否记住密码
                    <a style="color: white;" href="/register">注册账号</a>
                </label>
            </div>
            <div class="form-group">
                <button id="btnBindUser" type="button" class="btn btn-lg btn-primary">登录</button>
            </div>
        </form>
        <div role="alert" class="alert alert-danger hidden">.密码错误.</div>
    </div>
</div>
<script>
      var cookieOption = {day : 365};
      $(function(){
          $("#password").keypress(function(e){
            if (e.keyCode == 13) {
              login()
            }
          });
          $("#btnBindUser").click(login);
          if ($.cookie("un")) {
            $("#username").val(loginDecode($.cookie("un")));
            $("#password").focus();
          }else {
            $("#username").focus();
          }
          if ($.cookie("rp") == "1") {
            $("#password").val(loginDecode($.cookie("pw")));
            $("#rp")[0].checked = true;
          }
      });
      function login() {
        if ($.trim($("#username").val()) == "" || $.trim($("#password").val()) == "") {
              $.alert("请填写账号及密码");
              return;
          }
          var data = {
              username : $("#username").val(),
              password : $("#password").val()
          };
          $.cookie("un", loginEncode(data.username), cookieOption);
          if (!!$("#rp")[0].checked) {
            $.cookie("rp", "1", cookieOption);
            $.cookie("pw", loginEncode(data.password), cookieOption);
          }else {
            $.cookie("rp", "0");
            $.cookie("pw", null);
          }
          ajax("/api/security/login", data, function(data){
            if (data && data.code) {
                if (data.code == 200) {
                    window.location.href = "/";
                }else {
                    $.alert(data.msg);
                }
            }else {
                $.alert("登陆失败");
            }
          });
      }

      function loginEncode(str) {
        var encodeStr = "";
        for(var i = 0; i < str.length; i++)
            encodeStr += "\\" + str.charCodeAt(i).toString(8);
        return encodeStr;
      }

      function loginDecode(str) {
        var decodeStr = "";
        var s = str.split("\\");
        for(var i = 1; i < s.length; i++) {
            decodeStr += String.fromCharCode(parseInt(s[i],8));
        }
        return decodeStr;
      }
    </script>
<#include "/common/dialog.vm" />
</body>
</html>