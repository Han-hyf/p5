<!-- 图片点击放大 -->
<style type="text/css">
	img.img-big-view{
		cursor: pointer;
	}
</style>
<script type="text/javascript">
$(function(){
	var className = 'img-big-view';
	var imgSelector = 'img.img-big-view';
	$(document).on('click',imgSelector,function(){
		var src = $(this).attr('src');
		if(src){
			window.open(src,'_black');
		}
	})
})
</script>