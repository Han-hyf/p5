<script>
    $(function () {
        searchData();
    });

    //列表数据
    function searchData(pageNum) {
        var pageObejct = $("#pageDiv").pages()
        if (pageNum) {
            pageObejct.pageNum = pageNum;
        }
        ajax("/api/user/vip/list", $.extend($("#searchForm").getFormParam(), pageObejct), function (data) {
            if (data.code == 200) {
                if (data.data) {
                    $("#dataTable").html($.tmpl($("#dataTmpl").html(), data.data));
                }
            } else {
                $.alert(data.msg);
            }
        });
    }
</script>

